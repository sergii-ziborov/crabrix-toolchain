--- /dev/null
+++ b/compiler/rustc_codegen_cranelift/clif2wasm/tests/atomic_memory.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Execute atomic_memory_fixture.wasm with Wasmtime; pip install wasmtime first.
+
+Generate with cargo run --example atomic_memory_fixture -- /tmp/atomics.wasm,
+then python3 tests/atomic_memory.py /tmp/atomics.wasm. Tests real generated code,
+including adjacent nonzero fields and signed narrow RMW comparisons.
+"""
+import sys
+import wasmtime
+
+engine = wasmtime.Engine()
+store = wasmtime.Store(engine)
+exports = wasmtime.Instance(store, wasmtime.Module.from_file(engine, sys.argv[1]), []).exports(store)
+checks = 0
+
+
+def call(name, *args):
+    return exports[name](store, *args)
+
+
+def signed(value, bits):
+    return value - (1 << bits) if value & (1 << (bits - 1)) else value
+
+
+def canonical(value, bits):
+    return value & ((1 << bits) - 1) if bits >= 32 else value
+
+
+def argument(value, bits):
+    return signed(value, bits) if bits >= 32 else value
+
+
+for bits in (8, 16, 32, 64):
+    mask = (1 << bits) - 1
+    # Both canaries are nonzero. Testing an isolated zero-filled slot misses
+    # accidental widening of i8/i16 operations to i32.
+    offset = {8: 1, 16: 2, 32: 0, 64: 0}[bits]
+    address = 128 + offset
+    shift = offset * 8
+    for old in (0, 1, mask, 1 << (bits - 1), mask - 2):
+        before = (0xA55A96C3F0E1874B & ~(mask << shift)) | (old << shift)
+
+        def reset():
+            call("poke", 128, signed(before, 64))
+
+        def verify(value):
+            global checks
+            expected = (before & ~(mask << shift)) | ((value & mask) << shift)
+            actual = call("peek", 128) & ((1 << 64) - 1)
+            assert actual == expected, (bits, old, actual, expected)
+            checks += 1
+
+        reset()
+        actual = canonical(call(f"load{bits}", address), bits)
+        assert actual == old, ("load", bits, old, actual)
+        verify(old)
+        for operand in (0, 1, mask, 1 << (bits - 1), (1 << (bits - 1)) - 1):
+            reset()
+            call(f"store{bits}", address, argument(operand, bits))
+            verify(operand)
+            for expected in (old, old ^ 1):
+                reset()
+                actual = canonical(call(f"cas{bits}", address, argument(expected, bits), argument(operand, bits)), bits)
+                assert actual == old, ("cas", bits, old, actual)
+                verify(operand if expected == old else old)
+            operations = {
+                "add": old + operand, "sub": old - operand,
+                "and": old & operand, "or": old | operand,
+                "xor": old ^ operand, "xchg": operand,
+                "nand": ~(old & operand), "umin": min(old, operand), "umax": max(old, operand),
+                "smin": old if signed(old, bits) < signed(operand, bits) else operand,
+                "smax": old if signed(old, bits) > signed(operand, bits) else operand,
+            }
+            for op, expected in operations.items():
+                reset()
+                actual = canonical(call(f"{op}{bits}", address, argument(operand, bits)), bits)
+                assert actual == old, (op, bits, old, actual)
+                verify(expected)
+print(f"PASS: {checks} atomic memory/canary checks across i8/i16/i32/i64")
