+//! Emit real backend output for tests/atomic_memory.py (no runtime dependency).
+use clif2wasm::{NamedClifFunc, translate_module_multi};
+use cranelift_codegen::{
+    ir::{self, AbiParam, AtomicRmwOp, InstBuilder, MemFlags, Signature, UserFuncName, types},
+    isa::CallConv,
+};
+use cranelift_frontend::{FunctionBuilder, FunctionBuilderContext};
+
+fn function(ty: ir::Type, op: &str) -> ir::Function {
+    let mut sig = Signature::new(CallConv::SystemV);
+    sig.params.push(AbiParam::new(types::I32));
+    if op != "load" {
+        sig.params.push(AbiParam::new(ty));
+    }
+    if op == "cas" {
+        sig.params.push(AbiParam::new(ty));
+    }
+    if op != "store" {
+        sig.returns.push(AbiParam::new(ty));
+    }
+    let mut func = ir::Function::with_name_signature(UserFuncName::user(0, 0), sig);
+    let mut ctx = FunctionBuilderContext::new();
+    let mut b = FunctionBuilder::new(&mut func, &mut ctx);
+    let entry = b.create_block();
+    b.append_block_params_for_function_params(entry);
+    b.switch_to_block(entry);
+    let p = b.block_params(entry).to_vec();
+    let flags = MemFlags::trusted();
+    let result = match op {
+        "load" => Some(b.ins().atomic_load(ty, flags, p[0])),
+        "store" => {
+            b.ins().atomic_store(flags, p[1], p[0]);
+            None
+        }
+        "cas" => Some(b.ins().atomic_cas(flags, p[0], p[1], p[2])),
+        _ => {
+            let rmw = match op {
+                "add" => AtomicRmwOp::Add,
+                "sub" => AtomicRmwOp::Sub,
+                "and" => AtomicRmwOp::And,
+                "or" => AtomicRmwOp::Or,
+                "xor" => AtomicRmwOp::Xor,
+                "xchg" => AtomicRmwOp::Xchg,
+                "nand" => AtomicRmwOp::Nand,
+                "umin" => AtomicRmwOp::Umin,
+                "umax" => AtomicRmwOp::Umax,
+                "smin" => AtomicRmwOp::Smin,
+                "smax" => AtomicRmwOp::Smax,
+                _ => unreachable!(),
+            };
+            Some(b.ins().atomic_rmw(ty, flags, rmw, p[0], p[1]))
+        }
+    };
+    b.ins().return_(&result.into_iter().collect::<Vec<_>>());
+    b.seal_all_blocks();
+    b.finalize();
+    func
+}
+
+fn main() -> anyhow::Result<()> {
+    let mut functions = Vec::new();
+    let operations = [
+        "load", "store", "cas", "add", "sub", "and", "or", "xor", "xchg", "nand", "umin", "umax",
+        "smin", "smax",
+    ];
+    for (bits, ty) in [(8, types::I8), (16, types::I16), (32, types::I32), (64, types::I64)] {
+        for op in operations {
+            functions.push((format!("{op}{bits}"), function(ty, op)));
+        }
+    }
+    // Ordinary loads/stores provide an independent view of all neighboring bytes.
+    for (name, store) in [("peek", false), ("poke", true)] {
+        let mut sig = Signature::new(CallConv::SystemV);
+        sig.params.push(AbiParam::new(types::I32));
+        if store {
+            sig.params.push(AbiParam::new(types::I64));
+        } else {
+            sig.returns.push(AbiParam::new(types::I64));
+        }
+        let mut f = ir::Function::with_name_signature(UserFuncName::user(0, 0), sig);
+        let mut ctx = FunctionBuilderContext::new();
+        let mut b = FunctionBuilder::new(&mut f, &mut ctx);
+        let block = b.create_block();
+        b.append_block_params_for_function_params(block);
+        b.switch_to_block(block);
+        let p = b.block_params(block).to_vec();
+        if store {
+            b.ins().store(MemFlags::trusted(), p[1], p[0], 0);
+            b.ins().return_(&[]);
+        } else {
+            let v = b.ins().load(types::I64, MemFlags::trusted(), p[0], 0);
+            b.ins().return_(&[v]);
+        }
+        b.seal_all_blocks();
+        b.finalize();
+        functions.push((name.into(), f));
+    }
+    let named: Vec<_> = functions.iter().map(|(name, f)| NamedClifFunc::new(name, f)).collect();
+    let exports: Vec<_> = functions.iter().map(|(name, _)| name.as_str()).collect();
+    let wasm = translate_module_multi(&named, &[], &exports)?;
+    std::fs::write(std::env::args().nth(1).expect("output .wasm path"), wasm)?;
+    Ok(())
+}
