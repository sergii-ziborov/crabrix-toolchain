--- /dev/null
+++ b/library/proc_macro/src/bridge/wasm.rs
@@ -0,0 +1,240 @@
+//! Versioned, bounded transport for the existing proc-macro RPC protocol.
+//!
+//! Each macro runs in a separate WASI store. Only serialized bytes cross the
+//! host boundary: token and span handles continue to belong to rustc's normal
+//! Dispatcher. No client pointer, allocator or function-table index crosses
+//! between stores. The host must enforce aggregate fuel, deadline and memory
+//! limits and restrict module loading to declared build inputs.
+
+use std::cell::RefCell;
+use std::io::{self, ErrorKind};
+use std::path::Path;
+
+use super::client::{Client, ProcMacro};
+use super::server::{Dispatcher, Server};
+use super::{BridgeConfig, Buffer};
+
+const MAX_MESSAGE: usize = 16 * 1024 * 1024;
+const MAX_MACROS: usize = 4096;
+const LOAD: u32 = 1;
+const EXPAND: u32 = 2;
+const DISPATCH: u32 = 3;
+
+#[link(wasm_import_module = "crabrix_proc_macro_v1")]
+unsafe extern "C" {
+    fn exchange(operation: u32, module: u32, index: u32, ptr: *const u8, len: u32, flags: u32) -> u32;
+    fn read_reply(ptr: *mut u8, len: u32) -> u32;
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct RemoteClient {
+    module: u32,
+    index: u32,
+}
+
+fn call(operation: u32, remote: RemoteClient, input: &[u8], flags: u32) -> Vec<u8> {
+    assert!(input.len() <= MAX_MESSAGE, "proc-macro request exceeds transport limit");
+    // The host copies the request before invoking another store. Its reply
+    // remains owned by this caller until read_reply consumes it exactly once.
+    let length = unsafe {
+        exchange(operation, remote.module, remote.index, input.as_ptr(), input.len() as u32, flags)
+    } as usize;
+    assert!(length <= MAX_MESSAGE, "proc-macro reply exceeds transport limit");
+    let mut output = vec![0; length];
+    let copied = unsafe { read_reply(output.as_mut_ptr(), length as u32) };
+    assert_eq!(copied as usize, length, "incomplete proc-macro reply");
+    output
+}
+
+fn word(out: &mut Vec<u8>, value: u32) {
+    out.extend_from_slice(&value.to_le_bytes());
+}
+
+fn text(out: &mut Vec<u8>, value: &str) {
+    assert!(value.len() <= 16 * 1024);
+    word(out, value.len() as u32);
+    out.extend_from_slice(value.as_bytes());
+}
+
+struct Reader<'a>(&'a [u8]);
+
+impl<'a> Reader<'a> {
+    fn word(&mut self) -> io::Result<u32> {
+        let (bytes, rest) = self.0.split_at_checked(4).ok_or_else(invalid)?;
+        self.0 = rest;
+        Ok(u32::from_le_bytes(bytes.try_into().unwrap()))
+    }
+
+    fn text(&mut self) -> io::Result<&'static str> {
+        let length = self.word()? as usize;
+        if length > 16 * 1024 { return Err(invalid()); }
+        let (bytes, rest) = self.0.split_at_checked(length).ok_or_else(invalid)?;
+        self.0 = rest;
+        let value = std::str::from_utf8(bytes).map_err(|_| invalid())?;
+        // rustc's existing macro declarations have process-long lifetimes.
+        // This allocation is released when the compiler store is discarded.
+        Ok(Box::leak(value.to_owned().into_boxed_str()))
+    }
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(ErrorKind::InvalidData, "invalid Crabrix proc-macro v1 declaration")
+}
+
+impl<I, O> Client<I, O> {
+    fn remote(module: u32, index: u32) -> Self {
+        extern "C" fn unavailable(_: BridgeConfig<'_>) -> Buffer {
+            panic!("remote proc-macro invoked without its transport")
+        }
+        Self {
+            handle_counters: &super::client::COUNTERS,
+            remote: Some(RemoteClient { module, index }),
+            run: unavailable,
+            _marker: std::marker::PhantomData,
+        }
+    }
+}
+
+/// Load a reactor and decode only its declarations; no Rust ABI is shared.
+pub fn load(path: &Path, symbol: &str) -> io::Result<&'static [ProcMacro]> {
+    let mut request = Vec::new();
+    text(&mut request, path.to_str().ok_or_else(invalid)?);
+    text(&mut request, symbol);
+    let bytes = call(LOAD, RemoteClient { module: 0, index: 0 }, &request, 0);
+    let mut reader = Reader(&bytes);
+    if reader.word()? != 1 { return Err(invalid()); }
+    let module = reader.word()?;
+    let count = reader.word()? as usize;
+    if module == 0 || count > MAX_MACROS { return Err(invalid()); }
+    let mut macros = Vec::with_capacity(count);
+    for index in 0..count {
+        let kind = reader.word()?;
+        let name = reader.text()?;
+        if name.is_empty() { return Err(invalid()); }
+        macros.push(match kind {
+            0 => ProcMacro::Bang { name, client: Client::remote(module, index as u32) },
+            1 => ProcMacro::Attr { name, client: Client::remote(module, index as u32) },
+            2 => {
+                let count = reader.word()? as usize;
+                if count > MAX_MACROS { return Err(invalid()); }
+                let mut attributes = Vec::with_capacity(count);
+                for _ in 0..count { attributes.push(reader.text()?); }
+                ProcMacro::CustomDerive {
+                    trait_name: name,
+                    attributes: Box::leak(attributes.into_boxed_slice()),
+                    client: Client::remote(module, index as u32),
+                }
+            }
+            _ => return Err(invalid()),
+        });
+    }
+    if !reader.0.is_empty() { return Err(invalid()); }
+    Ok(Box::leak(macros.into_boxed_slice()))
+}
+
+// The erased pointer is installed only while run_remote owns the closure.
+// A guard removes it on unwind. Nested expansions push separate dispatchers;
+// their handles and symbol stores never enter another macro's client TLS.
+type DispatchFn = dyn FnMut(Buffer) -> Buffer;
+thread_local! {
+    static DISPATCHERS: RefCell<Vec<*mut DispatchFn>> = RefCell::new(Vec::new());
+}
+
+pub(super) fn run_remote<S: Server>(
+    remote: RemoteClient, dispatcher: &mut Dispatcher<S>, input: Buffer, panics: bool,
+) -> Buffer {
+    let mut dispatch = |buffer| dispatcher.dispatch(buffer);
+    let borrowed: &mut (dyn FnMut(Buffer) -> Buffer + '_) = &mut dispatch;
+    // SAFETY: this erases a lifetime, not the closure's type. The pointer cannot
+    // escape this dynamic scope; no RefCell borrow is held over guest execution.
+    let erased: *mut DispatchFn = unsafe { std::mem::transmute(borrowed) };
+    DISPATCHERS.with(|stack| stack.borrow_mut().push(erased));
+    struct Guard;
+    impl Drop for Guard {
+        fn drop(&mut self) { DISPATCHERS.with(|stack| { stack.borrow_mut().pop().unwrap(); }); }
+    }
+    let _guard = Guard;
+    Buffer::from(call(EXPAND, remote, &input, u32::from(panics)))
+}
+
+// Exported buffers are allocated, consumed and freed in the same store. The
+// trusted host must pass exactly the pointer/length returned by alloc or reply;
+// it never forwards a pointer from a different store.
+#[unsafe(no_mangle)]
+pub extern "C" fn __crabrix_pm_alloc(length: u32) -> u32 {
+    assert!(length as usize <= MAX_MESSAGE);
+    Box::into_raw(vec![0; length as usize].into_boxed_slice()) as *mut u8 as u32
+}
+
+unsafe fn take(pointer: u32, length: u32) -> Box<[u8]> {
+    assert!(length as usize <= MAX_MESSAGE);
+    unsafe { Box::from_raw(std::ptr::slice_from_raw_parts_mut(pointer as *mut u8, length as usize)) }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __crabrix_pm_free(pointer: u32, length: u32) {
+    drop(unsafe { take(pointer, length) });
+}
+
+fn reply(bytes: &[u8]) -> u64 {
+    assert!(bytes.len() <= MAX_MESSAGE);
+    let length = bytes.len() as u64;
+    let pointer = Box::into_raw(bytes.to_vec().into_boxed_slice()) as *mut u8 as u32;
+    (length << 32) | u64::from(pointer)
+}
+
+/// Called only by the host while run_remote has installed its dispatcher.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __crabrix_pm_dispatch(pointer: u32, length: u32) -> u64 {
+    let input = Buffer::from(unsafe { take(pointer, length) }.into_vec());
+    let callback = DISPATCHERS.with(|stack| *stack.borrow().last().expect("no active macro server"));
+    let output = unsafe { (&mut *callback)(input) };
+    reply(&output)
+}
+
+unsafe fn declarations(pointer: u32) -> &'static [ProcMacro] {
+    // The generated, exported proc-macro declarations static is a slice. Its
+    // address is resolved within this instance, never in the compiler's memory.
+    let declarations = unsafe { *(pointer as *const &'static [ProcMacro]) };
+    assert!(declarations.len() <= MAX_MACROS);
+    declarations
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __crabrix_pm_metadata(pointer: u32) -> u64 {
+    let declarations = unsafe { declarations(pointer) };
+    let mut bytes = Vec::new();
+    word(&mut bytes, declarations.len() as u32);
+    for declaration in declarations {
+        let kind = match declaration {
+            ProcMacro::Bang { .. } => 0,
+            ProcMacro::Attr { .. } => 1,
+            ProcMacro::CustomDerive { .. } => 2,
+        };
+        word(&mut bytes, kind);
+        text(&mut bytes, declaration.name());
+        if let ProcMacro::CustomDerive { attributes, .. } = declaration {
+            assert!(attributes.len() <= MAX_MACROS);
+            word(&mut bytes, attributes.len() as u32);
+            for attribute in *attributes { text(&mut bytes, attribute); }
+        }
+    }
+    reply(&bytes)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __crabrix_pm_expand(
+    declarations_pointer: u32, index: u32, pointer: u32, length: u32, panics: u32,
+) -> u64 {
+    let declaration = &unsafe { declarations(declarations_pointer) }[index as usize];
+    let input = Buffer::from(unsafe { take(pointer, length) }.into_vec());
+    let mut dispatch = |buffer: Buffer| {
+        Buffer::from(call(DISPATCH, RemoteClient { module: 0, index: 0 }, &buffer, 0))
+    };
+    let config = BridgeConfig { input, dispatch: (&mut dispatch).into(), force_show_panics: panics != 0 };
+    let output = match declaration {
+        ProcMacro::Bang { client, .. } | ProcMacro::CustomDerive { client, .. } => (client.run)(config),
+        ProcMacro::Attr { client, .. } => (client.run)(config),
+    };
+    reply(&output)
+}
