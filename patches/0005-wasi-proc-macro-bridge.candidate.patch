+/// A proc macro is a static reactor containing its ordinary Rust metadata and
+/// versioned RPC exports. No --shared/PIC emulation or native dlopen is used.
+#[cfg(all(target_arch = "wasm32", target_os = "wasi"))]
+fn link_wasi_proc_macro(
+    sess: &Session, output: &Path, modules: &CompiledModules,
+    info: &CrateInfo, metadata: &EncodedMetadata,
+) {
+    let mut options = riwl::LinkOptions::default();
+    options.no_entry = true;
+    options.stack_size = 1024 * 1024;
+    options.exports = [
+        "__crabrix_pm_alloc", "__crabrix_pm_free", "__crabrix_pm_metadata",
+        "__crabrix_pm_expand", "__wasm_call_ctors",
+    ].iter().map(|name| name.to_string()).collect();
+    // The native dylib export list also contains rust_metadata_*; a WASI
+    // reactor stores that data in the .rustc custom section below, not in a
+    // separate metadata object. Only the declarations slice needs an address
+    // export for the versioned RPC loader.
+    options.exports.extend(info.exported_symbols[&CrateType::ProcMacro].iter()
+        .filter(|(name, _)| name.starts_with("__rustc_proc_macro_decls_"))
+        .map(|(name, _)| name.clone()));
+    for module in &modules.modules {
+        if let Some(path) = &module.object { options.inputs.push(path.clone()); }
+    }
+    if let Some(path) = modules.allocator_module.as_ref().and_then(|module| module.object.as_ref()) {
+        options.inputs.push(path.clone());
+    }
+    each_linked_rlib(info, Some(CrateType::ProcMacro), &mut |_, path| {
+        options.inputs.push(path.to_owned());
+    }).unwrap_or_else(|error| sess.dcx().emit_fatal(error));
+    options.inputs.push(sess.target_tlib_path.dir.join("self-contained/libc.a"));
+    let mut bytes = riwl::link(&options)
+        .unwrap_or_else(|error| sess.dcx().fatal(format!("macro reactor link: {error:#}")));
+    // Match the default dylib metadata loader's .rustc representation exactly.
+    let mut section = vec![6];
+    section.extend_from_slice(b".rustc");
+    section.extend_from_slice(rustc_metadata::METADATA_HEADER);
+    section.extend_from_slice(&(metadata.stub_or_full().len() as u64).to_le_bytes());
+    section.extend_from_slice(metadata.stub_or_full());
+    bytes.push(0);
+    let mut size = section.len();
+    loop {
+        let byte = (size & 0x7f) as u8;
+        size >>= 7;
+        bytes.push(byte | if size == 0 { 0 } else { 0x80 });
+        if size == 0 { break; }
+    }
+    bytes.extend_from_slice(&section);
+    fs::write(output, bytes).unwrap_or_else(|error| sess.dcx().fatal(format!("macro reactor output: {error}")));
+}
