+    use super::{link, LinkOptions};
+
+    #[test]
+    fn reactor_can_export_synthesized_ctors_without_an_input_symbol() {
+        let mut options = LinkOptions::default();
+        options.no_entry = true;
+        options.exports = vec!["__wasm_call_ctors".into()];
