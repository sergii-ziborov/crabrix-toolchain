 fn mem_arg(cx: &FnCx, offset: ir::immediates::Offset32) -> Result<MemoryArg> {
     let off: i32 = offset.into();
     ensure!(off >= 0, "negative load/store offset {off} is unsupported (wasm offsets are unsigned)");
