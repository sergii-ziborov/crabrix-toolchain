+/// Narrow CLIF integers use i32 locals, but must retain their actual memory
+/// width. Widening an AtomicBool/i8/i16 access reads or corrupts adjacent fields.
+fn atomic_memory_ops(ty: ir::Type, memory: MemoryArg) -> Result<(Operator, Operator)> {
+    Ok(match ty {
+        types::I8 => (Operator::I32Load8U { memory }, Operator::I32Store8 { memory }),
+        types::I16 => (Operator::I32Load16U { memory }, Operator::I32Store16 { memory }),
+        types::I32 => (Operator::I32Load { memory }, Operator::I32Store { memory }),
+        types::I64 => (Operator::I64Load { memory }, Operator::I64Store { memory }),
+        other => bail!("atomic memory access of {other} unimplemented"),
+    })
+}
