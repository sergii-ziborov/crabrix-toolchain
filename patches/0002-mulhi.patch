+    let b_sign = op1(body, wb, I64ShrS, &[b, c63], Type::I64);
+    let a_adjust = op1(body, wb, I64And, &[a_sign, b], Type::I64);
+    let b_adjust = op1(body, wb, I64And, &[b_sign, a], Type::I64);
+    let once = op1(body, wb, I64Sub, &[unsigned, a_adjust], Type::I64);
+    op1(body, wb, I64Sub, &[once, b_adjust], Type::I64)
